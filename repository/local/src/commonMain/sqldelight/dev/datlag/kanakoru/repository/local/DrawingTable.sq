CREATE TABLE IF NOT EXISTS DrawingTable(
    char INTEGER PRIMARY KEY NOT NULL,
    score REAL DEFAULT 0.0,
    reviewCount INTEGER NOT NULL DEFAULT 0,
    lastReview INTEGER,
    updatedAt INTEGER
);

getDrawingStats:
SELECT * FROM DrawingTable WHERE char = ?;

getDrawingStatsForGroup:
SELECT * FROM DrawingTable WHERE char IN ?;

upsertDrawingProgress {
    UPDATE DrawingTable
    SET score = :newScore,
        reviewCount = :newCount,
        lastReview = :timestamp,
        updatedAt = :timestamp
    WHERE char = :char;

    INSERT OR IGNORE INTO DrawingTable(char, score, reviewCount, lastReview, updatedAt)
    VALUES (:char, :newScore, :newCount, :timestamp, :timestamp);
}